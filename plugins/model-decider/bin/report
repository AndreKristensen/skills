#!/usr/bin/env bash
# Summarizes the model-decider log for the /decider-report skill.
# Usage: report [Nd]   (default 7d)
set -euo pipefail

DATA="${MODEL_DECIDER_HOME:-$HOME/.claude/model-decider}"
LOG="$DATA/log.jsonl"
period=${1:-7d}
[[ "$period" =~ ^[0-9]+d$ ]] || { echo "Period must look like 7d or 30d, got: $period" >&2; exit 1; }
since=$(date -u -d "-${period%d} days" +%Y-%m-%dT%H:%M:%SZ)

if [ ! -s "$LOG" ]; then echo "Log is empty: $LOG"; exit 0; fi

jq -rs --arg since "$since" --arg period "$period" '
  def family: if . == null then null else (ascii_downcase | capture("(?<f>haiku|sonnet|opus|fable)").f? // .) end;
  def pct(n; d): if d == 0 then "-" else "\((n * 100 / d) | floor)%" end;
  def proj: split("/") | last;

  map(select(.ts >= $since)) as $all
  | ($all | map(select(.event == "resolved")) | INDEX(.id)) as $resolved
  | ($all | map(select(.event == "pick"))
     | map(. as $p
           | ($resolved[$p.id].model // $p.model) as $m
           | $p + {model: $m, ran: (($m | family) // $p.tier)})) as $picks
  | ($all | map(select(.event == "turn")) | INDEX(.id)) as $turns
  | ($all | map(select(.event == "rate")) | INDEX(.pick_id)) as $rates
  | ["haiku", "sonnet", "opus"] as $tiers

  | "Period: last \($period) (since \($since)). Picks: \($picks | length).",
    "",
    "Tier split per project (by model that actually ran)",
    "| Project | haiku | sonnet | opus | other |",
    "|---|---|---|---|---|",
    ($picks | group_by(.project)[] | . as $g
     | "| \($g[0].project | proj) | "
       + ([$tiers[], "other"] | map(. as $t | $g | map(select(if $t == "other" then (.ran | IN($tiers[]) | not) else .ran == $t end)) | length | tostring) | join(" | "))
       + " |"),
    "",
    "Overrides and escalations by picked tier",
    "| Tier | Picks | Overridden to other tier | Escalated away (tag) | Suspected escalation | Rated wrong |",
    "|---|---|---|---|---|---|",
    ($tiers[] as $t
     | ($picks | map(select(.tier == $t))) as $tp
     | ($tp | length) as $n
     | "| \($t) | \($n) | \(pct($tp | map(select(.override != null and .override != $t)) | length; $n))"
       + " | \(pct($picks | map(select(.escalate_from == $t)) | length; $n))"
       + " | \(pct($tp | map(select($turns[.prompt_id // ""].suspected_escalation == true)) | length; $n))"
       + " | \(pct($tp | map(select($rates[.id].verdict == "should-be")) | length; $n)) |"),
    "",
    "Ratings: \($rates | length) (\($rates | map(select(.verdict == "ok")) | length) ok)",
    "",
    "Candidate suspicious picks (JSON lines):",
    ($picks
     | map(. as $p
           | ($turns[$p.prompt_id // ""]) as $turn
           | [ (if $p.tier == "opus" and $p.override == null and ($p.tool_calls // 99) <= 3 and ($p.output_tokens // 99999) < 1500 then "small opus turn" else empty end),
               (if $p.override != null and $p.override != $p.tier then "overridden to \($p.override)" else empty end),
               (if ($picks | any(.escalate_from == $p.tier and .prompt_id == $p.prompt_id and .id != $p.id)) then "escalated away" else empty end),
               (if $turn.suspected_escalation == true and $p.tier != "opus" then "main did \($turn.tools_after_last_agent) tool calls after subagent" else empty end),
               (if $rates[$p.id].verdict == "should-be" then "rated should be \($rates[$p.id].should_be)" else empty end),
               (if $p.tier != "opus" and $p.reason == null then "no reason tag" else empty end)
             ] as $signals
           | select($signals | length > 0)
           | {ts: $p.ts, project: ($p.project | proj), picked: $p.tier, ran: $p.ran, model: $p.model,
              reason: $p.reason, desc: $p.desc, prompt: $p.prompt,
              tool_calls: $p.tool_calls, output_tokens: $p.output_tokens, signals: $signals})
     | sort_by(-(.signals | length)) | .[0:30][] | tojson)
' "$LOG"
